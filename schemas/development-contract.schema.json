{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/codex-supervisor/development-contract.schema.json",
  "title": "DevelopmentContractV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "clientRequestId",
    "objective",
    "plan",
    "scope",
    "acceptanceCriteria"
  ],
  "properties": {
    "contractVersion": { "const": "1.0" },
    "clientRequestId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "title": { "type": "string", "minLength": 1, "maxLength": 500 },
    "objective": { "type": "string", "minLength": 1, "maxLength": 100000 },
    "plan": {
      "type": "array",
      "maxItems": 200,
      "items": { "type": "string", "minLength": 1, "maxLength": 10000 }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in"],
      "properties": {
        "in": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "type": "string", "minLength": 1, "maxLength": 10000 }
        },
        "out": {
          "type": "array",
          "maxItems": 200,
          "items": { "type": "string", "minLength": 1, "maxLength": 10000 },
          "default": []
        }
      }
    },
    "constraints": {
      "type": "array",
      "maxItems": 200,
      "items": { "type": "string", "minLength": 1, "maxLength": 10000 },
      "default": []
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 100 },
          "description": { "type": "string", "minLength": 1, "maxLength": 10000 },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 10000 }
        }
      }
    },
    "requiredVerificationRecipes": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 },
      "default": []
    },
    "allowedChangePaths": {
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repositoryRelativePath" }
    },
    "forbiddenChangePaths": {
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repositoryRelativePath" }
    },
    "maxCorrectionPasses": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "default": 3
    },
    "metadata": {
      "type": "object",
      "maxProperties": 200,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "not": { "enum": ["__proto__", "prototype", "constructor"] }
      },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 10000 }
    }
  },
  "$defs": {
    "repositoryRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "anyOf": [
        { "pattern": "^(?![\\\\/])(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[^*?\\[\\]]+$" },
        { "pattern": "^(?![\\\\/])(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[^*?\\[\\]]+[\\\\/]\\*\\*$" }
      ]
    }
  }
}
