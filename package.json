{
  "name": "codex-supervisor-mcp",
  "version": "0.4.0",
  "description": "A remote MCP control plane that lets ChatGPT supervise Codex while Codex owns code execution.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "validate:generic": "node scripts/validate-generic.mjs",
    "validate:phase03": "node scripts/validate-phase03.mjs",
    "validate:phase04": "node scripts/validate-phase04.mjs",
    "validate:phase05": "node scripts/validate-phase05.mjs",
    "validate:tool-surface": "tsx scripts/chatgpt/export-tool-manifest.ts --check",
    "validate:version-consistency": "tsx scripts/validate-version-consistency.ts",
    "validate:security": "node scripts/validate-security.mjs",
    "diagnose:codex": "tsx scripts/diagnose-codex-cli.ts",
    "preflight:wsl2": "tsx scripts/preflight-wsl2.ts",
    "preflight:tunnel": "tsx scripts/preflight-secure-tunnel.ts",
    "smoke:mcp": "tsx scripts/smoke-mcp.ts",
    "smoke:codex": "tsx scripts/live/codex-handshake-smoke.ts",
    "e2e:codex": "tsx scripts/live/codex-development-e2e.ts",
    "operator": "tsx src/cli/supervisorctl.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run validate:generic && npm run smoke:mcp && npm run validate:phase04 && npm run validate:phase05 && npm run validate:tool-surface && npm run validate:version-consistency && npm run validate:security"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
