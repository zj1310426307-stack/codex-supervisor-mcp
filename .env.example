# Local bind. Keep loopback when using a private tunnel client.
MCP_HOST=127.0.0.1
MCP_PORT=8787
MCP_PATH=/mcp

# Required when MCP_HOST is not loopback or when an external reverse proxy can reach this process.
MCP_BEARER_TOKEN=

# Optional comma-separated HTTP Host / Origin allowlists.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# Codex binary and optional CODEX_HOME override. The service never installs
# Codex or modifies PATH, aliases, the registry, or OS app registrations.
CODEX_BIN=codex
CODEX_HOME=
# Optional explicit model for new supervised threads. Leave empty to use the
# Codex account/config default.
CODEX_MODEL=
CODEX_EXPERIMENTAL_API=false
CODEX_READ_RETRIES=2
CODEX_RETRY_BASE_DELAY_MS=50
CODEX_RETRY_MAX_DELAY_MS=1000
CODEX_SHUTDOWN_TIMEOUT_MS=5000

# Semicolon-separated roots that Codex is allowed to work inside.
# Windows example: C:\\dev;D:\\work
# macOS/Linux example: /Users/me/dev;/srv/work
CODEX_WORKSPACE_ROOTS=/absolute/path/to/projects

# Persistent supervisor ledger. Pending Codex approvals themselves are process-local;
# task/thread ids and audit events are persisted here.
SUPERVISOR_STATE_FILE=.codex-supervisor/state.json
SUPERVISOR_WORKTREE_ROOT=.codex-supervisor/worktrees
SUPERVISOR_VERIFICATION_CONFIG=config/verification.example.json

# Turn/worker ownership and watchdog bounds.
SUPERVISOR_TURN_LEASE_TTL_MS=30000
SUPERVISOR_TURN_WARN_IDLE_MS=60000
SUPERVISOR_TURN_SUSPECT_IDLE_MS=180000
SUPERVISOR_TURN_HARD_DEADLINE_MS=3600000
SUPERVISOR_VERIFIER_LEASE_TTL_MS=20000
SUPERVISOR_MAX_VERIFICATION_OUTPUT_CHARS=50000

# Runtime guardrails.
SUPERVISOR_MAX_EVENTS_PER_TASK=500
SUPERVISOR_MAX_EVENT_PAYLOAD_CHARS=30000
SUPERVISOR_MAX_DIFF_CHARS=60000
SUPERVISOR_REQUEST_TIMEOUT_MS=30000

# HTTP resource bounds.
MCP_MAX_BODY_BYTES=1048576
MCP_RATE_LIMIT_MAX_REQUESTS=120
MCP_RATE_LIMIT_WINDOW_MS=60000
MCP_HEADERS_TIMEOUT_MS=10000
MCP_REQUEST_TIMEOUT_MS=30000
MCP_READINESS_TIMEOUT_MS=3000

# false = expose read-only supervision tools only (useful for restricted clients)
MCP_CONTROL_ENABLED=false
