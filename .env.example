# Local bind. Keep loopback when using a private tunnel client.
MCP_HOST=127.0.0.1
MCP_PORT=8787
MCP_PATH=/mcp

# Required when MCP_HOST is not loopback or when an external reverse proxy can reach this process.
MCP_BEARER_TOKEN=replace-with-a-long-random-secret

# Optional comma-separated HTTP Host / Origin allowlists.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# Codex binary and optional CODEX_HOME override.
CODEX_BIN=codex
CODEX_HOME=

# Semicolon-separated roots that Codex is allowed to work inside.
# Windows example: C:\\dev;D:\\work
# macOS/Linux example: /Users/me/dev;/srv/work
CODEX_WORKSPACE_ROOTS=/absolute/path/to/projects

# Persistent supervisor ledger. Pending Codex approvals themselves are process-local;
# task/thread ids and audit events are persisted here.
SUPERVISOR_STATE_FILE=.codex-supervisor/state.json

# Runtime guardrails.
SUPERVISOR_MAX_EVENTS_PER_TASK=500
SUPERVISOR_MAX_EVENT_PAYLOAD_CHARS=30000
SUPERVISOR_MAX_DIFF_CHARS=60000
SUPERVISOR_REQUEST_TIMEOUT_MS=30000

# false = expose read-only supervision tools only (useful for restricted clients)
MCP_CONTROL_ENABLED=true
